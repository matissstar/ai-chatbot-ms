# --- class-admin.php: Export section ---

msgid "Satura eksports"
msgstr "Content Export"

msgid "Eksportējiet visus WooCommerce produktus, lapas, rakstus un citu saturu uz JSON failu, lai AI varētu tos izmantot gudrām atbildēm."
msgstr "Export all WooCommerce products, pages, posts and other content to a JSON file so AI can use them for smart answers."

msgid "JSON fails automātiski atjauninās katru reizi, kad jūs pievienosiet, rediģēsiet vai dzēsīsiet jebkuru lapu, rakstu vai produktu."
msgstr "The JSON file will automatically update each time you add, edit or delete any page, post or product."

msgid "Eksportēt visu saturu uz JSON"
msgstr "Export all content to JSON"

msgid "JSON fails pieejams:"
msgstr "JSON file available:"
