# --- class-chatbot.php: Search responses ---

msgid "Vaicājums ir tukšs."
msgstr "Query is empty."

msgid "Atradu %d preces! Šeit ir 16 labākās. Sašaurini meklēšanu:"
msgstr "Found %d products! Here are the top 16. Narrow your search:"

msgid "Šeit ir dažas iespējas:"
msgstr "Here are some options:"

msgid "Atvainojiet, bet jūsu vaicājums nav saprotams. Mēģiniet precizēt vai meklēt konkrētu preci."
msgstr "Sorry, your query could not be understood. Try to be more specific or search for a particular product."

# --- class-chatbot.php: Filter chips ---

msgid "Līdz"
msgstr "Up to"

msgid "Virs"
msgstr "Over"

# --- class-chatbot.php: Gift search ---

msgid "Dāvanu idejas"
msgstr "Gift ideas"

msgid "līdz"
msgstr "up to"

msgid "🎁 Es labprāt palīdzēšu atrast dāvanu! Lai labāk ieteiktu, pastāsti vairāk:"
msgstr "🎁 I'd love to help find a gift! To recommend better, tell me more:"

msgid "Kam ir dāvana? (sievietei, vīrietim, bērnam...)"
msgstr "Who is the gift for? (woman, man, child...)"

msgid "Kādas ir viņa/viņas intereses? (sports, tehnoloģijas, dārzniecība, virtuve...)"
msgstr "What are their interests? (sports, technology, gardening, cooking...)"

msgid "Kāds ir budžets? (līdz 20€, 20-50€, virs 50€...)"
msgstr "What is your budget? (up to €20, €20-50, over €50...)"

